# Copy to ~/.config/smart-plug/env and chmod 600.
# systemd EnvironmentFile format: KEY=value, one per line, no `export`.
# Quote values that contain spaces (e.g. the alias) — systemd strips the quotes
# and it also lets you `source` this file directly for a manual run.
#
# The plug is found by its alias via discovery, so no fixed IP is needed.
KASA_ALIAS="Tapo P110"
KASA_USERNAME=you@example.com
KASA_PASSWORD=your-tplink-password
